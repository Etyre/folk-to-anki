# Copy to config.env (untracked) and fill in. Lines are KEY=value; # starts a comment.

# Folk API key: folk > Settings > API keys (API access needs the Premium plan).
FOLK_API_KEY=
# Folk group that holds the networking contacts. The script's custom fields
# (Meeting status, Last met, Next meeting, Anki card, Party, Office, Deal, Photo URL)
# live on this group, and flagged people are added to it.
FOLK_GROUP=Networking
# Optional: a Folk group whose members are DC people (makes "Auto" card type = DC staffer).
FOLK_DC_GROUP=

# Google Calendar "Secret address in iCal format" feeds, comma separated.
# Same URLs as the executive assistant's CALENDAR_ICS_URLS.
CALENDAR_ICS_URLS=
# Your own addresses (never flagged) and colleague domains (never flagged), comma separated.
MY_EMAILS=elityre@gmail.com,eli@palisaderesearch.org
IGNORE_EMAIL_DOMAINS=palisaderesearch.org,lu.ma
# Events with more attendees than this are talks or all-hands, not meetings.
MAX_ATTENDEES=10
# How far ahead "Planning to meet" looks, and how far back "Met" looks (0 = all history).
UPCOMING_DAYS=90
PAST_DAYS=0

# Anki
ANKICONNECT_URL=http://localhost:8765
DECK_DC=Daily review::*-DC networking
DECK_NETWORKING=Daily review::*-Networking
# Local photos, named <folk person id>.jpg/.png, used when Folk has no Photo URL.
PHOTOS_DIR=~/Library/Application Support/FolkToAnki/photos
