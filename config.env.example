# Copy to config.env (untracked) and fill in. Lines are KEY=value; # starts a comment.

# Folk API key: folk > Settings > API keys (API access needs the Premium plan).
FOLK_API_KEY=
# Folk groups to track, comma separated. folk has no workspace-wide columns, so the shared
# fields (Met with, Meeting planned with, Last met, Next meeting) are created on each of these
# and written to whichever of them a person is already in. People are never moved between groups.
FOLK_GROUPS=US Govt,Partner orgs,Press,Corporate,Donor,Other govts
# Name tagged in "Met with" / "Meeting planned with" for the owner of the calendar feeds below.
# Cards are made for people carrying this name in either field.
MY_NAME=Eli
# A folk group whose members are DC people (makes the inferred card type DC staffer). Read only.
FOLK_DC_GROUP=US Govt

# Google Calendar "Secret address in iCal format" feeds, comma separated.
# Same URLs as the executive assistant's CALENDAR_ICS_URLS.
CALENDAR_ICS_URLS=
# Your own addresses (never flagged) and colleague domains (never flagged), comma separated.
MY_EMAILS=elityre@gmail.com,eli@palisaderesearch.org
IGNORE_EMAIL_DOMAINS=palisaderesearch.org,lu.ma
# Events with more attendees than this are talks or all-hands, not meetings.
MAX_ATTENDEES=10
# How far ahead "Planning to meet" looks, and how far back "Met" looks (0 = all history).
UPCOMING_DAYS=90
PAST_DAYS=0

# Anki
ANKICONNECT_URL=http://localhost:8765
DECK_DC=Daily review::*-DC networking
DECK_NETWORKING=Daily review::*-Networking
# Member cards: the top SENATORS_TOTAL senators and REPS_TOTAL House members by importance (see
# top_members.py), released <CHAMBER>_PER_DAY per day in that order. A total of 0 turns one off.
# To put someone first, list names one per line in
# ~/Library/Application Support/FolkToAnki/member-priority.txt.
SENATORS_TOTAL=50
SENATORS_PER_DAY=2
REPS_TOTAL=25
REPS_PER_DAY=2
# While the incoming-Congress file applies, a Claude agent (Agent SDK, same login as the photo
# agent) checks the news every ROLES_CHECK_DAYS for leadership votes and committee chair picks.
# Look up missing job titles (and write them, and names the photo agent identified, to folk with
# a note saying they came from Eli's Claude). People are asked about once, then every 60 days.
TITLES_AGENT=on
TITLES_AGENT_BUDGET_USD=5.0
ROLES_AGENT=on
ROLES_CHECK_DAYS=2
ROLES_AGENT_BUDGET_USD=5.0
# Local photos, named <folk person id>.jpg/.png, used when Folk has no Photo URL.
PHOTOS_DIR=~/Library/Application Support/FolkToAnki/photos
# When nothing above yields a photo, a Claude agent (Claude Agent SDK, billed to the Claude Code
# login on this Mac) searches the web for one. Found URLs are written to folk's Photo URL field.
PHOTO_SEARCH=on
PHOTO_SEARCH_BUDGET_USD=5.0
# A person for whom no photo was found is searched again after this many days.
PHOTO_SEARCH_RETRY_DAYS=60
